# I Am Human Foundation — environment variables
#
# Copy the names, not this file, into your Vercel project:
#   Vercel dashboard -> the project -> Settings -> Environment Variables
#
# NEVER commit real values. This file exists to document the names only.
# Anything secret here would end up on GitHub the moment it is filled in.

# ---- Stripe (card payments) -------------------------------------------------
# Secret key. Server side only. Starts sk_live_ in production, sk_test_ for testing.
STRIPE_SECRET_KEY=<your Stripe secret key>

# Canonical site origin, used to build the Stripe return URLs.
# Optional: the request's own origin is used when this is unset.
SITE_URL=https://iamhumanfdn.vercel.app

# Currency. Prices are stored PER CURRENCY, so changing a currency without also
# supplying prices in it makes those items refuse to sell rather than charge the
# wrong figure.
#
# Prospectus items ship with usd prices (converted from the GHS figures at
# 11.3730 GHS/USD on 2026-09-07) and the original ghs figures alongside.
# Stripe does not support Ghana as an account country, so usd is the default.
#   SECOND_CHANCE_CURRENCY  prospectus items.  Default: usd
#   STRIPE_CURRENCY         general donations. Default: eur
# SECOND_CHANCE_CURRENCY=usd

# Price table, in the currency's MINOR unit (cents), merged over the built-in one.
# Only needed if you move to a currency with no prices in the catalogue.
# STRIPE_PRICES={"tier-founding":{"gbp":350000},"ticket":{"gbp":6300}}

# To let visitors pay in their own local currency, enable Adaptive Pricing in the
# Stripe Dashboard (settings/adaptive-pricing). No code or variable needed.

# ---- Resend (contact + mailing list email) ----------------------------------
RESEND_API_KEY=<your Resend API key>
MAIL_FROM=website@iamhumanfdn.org
MAIL_TO=contact@iamhumanfdn.org
